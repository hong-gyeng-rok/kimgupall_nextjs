// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  // engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// ==========================================
// 1. Users (관리자/사용자)
// ==========================================
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  role         String   @default("USER")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  likes Like[]

  @@map("users")
}

// ==========================================
// 2. Collections (그룹/컨셉)
// ==========================================
model Collection {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique
  title        String
  description  String?  @db.VarChar(500)
  thumbnailUrl String?  @map("thumbnail_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  location     String? 
  media Media[]

  @@map("collections")
}

// ==========================================
// 3. Media (미디어 리소스 - 이미지/비디오)
// ==========================================
model Media {
  id           String   @id @default(uuid()) @db.Uuid
  collectionId String?  @map("collection_id") @db.Uuid
  type         String   // 'IMAGE' | 'VIDEO'
  location     String   @default("GALLERY")
  publicUrl    String   @map("public_url")
  storagePath  String?  @map("storage_path")
  title        String?
  description  String?  @db.Text
  altText      String?  @map("alt_text")
  width        Int?     @db.SmallInt
  height       Int?     @db.SmallInt
  posterUrl    String?  @map("poster_url")
  orderIndex   Int      @map("order_index")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  collection Collection? @relation(fields: [collectionId], references: [id])
  likes      Like[]

  // 인덱스 전략
  @@index([location], map: "idx_media_location")
  @@index([collectionId, orderIndex], map: "idx_media_collection_order")
  @@map("media")
}

// ==========================================
// 4. Likes (좋아요)
// ==========================================
model Like {
  id        String   @id @default(uuid()) @db.Uuid
  mediaId   String   @map("media_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  sessionId String?  @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 복합 유니크 인덱스
  @@unique([mediaId, userId])
  @@unique([mediaId, sessionId])
  @@map("likes")
}